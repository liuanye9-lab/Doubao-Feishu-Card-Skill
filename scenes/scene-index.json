{
  "version": "1.0",
  "default": "event-info",
  "purpose": "飞书 AI 先锋大赛组织运营全流程的场景模板注册表；scene 负责环节，preset 负责视觉。",
  "scenes": [
    {
      "id": "prelaunch-promo",
      "name": "前期宣发",
      "phase": "pre",
      "type": "launch",
      "default_preset": "pioneer-red",
      "goal": "让目标参与者快速知道活动是什么、为什么值得参加、如何报名。",
      "trigger": "首次发布活动或预热海报",
      "keywords": ["报名", "招募", "宣发", "开营", "参加"],
      "required_fields": ["title", "lead", "date_label", "facts"],
      "recommended_blocks": ["heading", "facts", "section", "button"],
      "recipe": ["一句话价值主张", "活动对象与亮点", "关键日期", "唯一报名入口"],
      "example": "examples/pioneer-scenes/prelaunch-promo.spec.json"
    },
    {
      "id": "event-info",
      "name": "活动信息",
      "phase": "pre",
      "type": "custom",
      "default_preset": "oriental-ink",
      "goal": "把活动时间、地点、对象、形式和参与方式集中讲清楚。",
      "trigger": "活动详情正式发布",
      "keywords": ["活动时间", "活动地点", "活动信息", "对象", "形式"],
      "required_fields": ["title", "date_label", "facts", "sections"],
      "recommended_blocks": ["heading", "metrics", "section", "button"],
      "recipe": ["活动名称", "时间 / 地点 / 对象事实块", "参与方式", "详情入口"],
      "example": "examples/pioneer-scenes/event-info.spec.json"
    },
    {
      "id": "activity-timeline",
      "name": "活动时间线",
      "phase": "pre",
      "type": "timeline",
      "default_preset": "oriental-ink",
      "goal": "让参与者一眼掌握从报名、培训、提交到决赛的节奏。",
      "trigger": "流程公布或阶段发生变化",
      "keywords": ["时间线", "活动安排", "流程", "节点", "阶段"],
      "required_fields": ["title", "timeline"],
      "recommended_blocks": ["facts", "timeline", "collapse"],
      "recipe": ["当前阶段", "纵向日期节点", "每阶段动作", "展开补充说明"],
      "example": "examples/pioneer-scenes/activity-timeline.spec.json"
    },
    {
      "id": "training-notice",
      "name": "培训通知",
      "phase": "during",
      "type": "training",
      "default_preset": "blueprint-blue",
      "goal": "让参与者知道何时参加、参加前准备什么、培训后产出什么。",
      "trigger": "每场培训或答疑前",
      "keywords": ["培训", "课程", "讲座", "学习", "教程"],
      "required_fields": ["title", "date_label", "facts", "sections"],
      "recommended_blocks": ["metrics", "section", "collapse", "button"],
      "recipe": ["课程目标", "时间 / 对象 / 形式", "课前准备", "课后动作"],
      "example": "examples/pioneer-scenes/training-notice.spec.json"
    },
    {
      "id": "task-reminder",
      "name": "活动事项提醒",
      "phase": "during",
      "type": "custom",
      "default_preset": "pioneer-red",
      "goal": "把即将到期的任务变成清晰、可执行、可检查的提醒。",
      "trigger": "截止前 1-3 天或关键节点当天",
      "keywords": ["提醒", "待办", "请务必", "截止", "最后"],
      "required_fields": ["title", "date_label", "facts", "sections"],
      "recommended_blocks": ["heading", "facts", "section", "button"],
      "recipe": ["截止时间先行", "待办清单", "提交标准", "唯一行动入口"],
      "example": "examples/pioneer-scenes/task-reminder.spec.json"
    },
    {
      "id": "submission-call",
      "name": "作品征集与提交",
      "phase": "during",
      "type": "submission",
      "default_preset": "pioneer-red",
      "goal": "让参赛者理解提交要求，并在一个入口完成作品提交。",
      "trigger": "开放提交或提交截止提醒",
      "keywords": ["提交作品", "作品提交", "作品征集", "参赛作品", "提交内容", "提交入口", "交付"],
      "required_fields": ["title", "date_label", "facts", "sections", "buttons"],
      "recommended_blocks": ["facts", "section", "collapse", "button"],
      "recipe": ["提交截止", "作品要求", "提交前自检", "提交入口"],
      "example": "examples/pioneer-scenes/submission-call.spec.json"
    },
    {
      "id": "case-showcase",
      "name": "作品案例展示",
      "phase": "during",
      "type": "story",
      "default_preset": "olive-editorial",
      "goal": "用问题、做法、结果讲清楚一件作品为什么有价值。",
      "trigger": "优秀作品发布或阶段性案例分享",
      "keywords": ["案例", "作品展示", "成果展示", "作品介绍"],
      "required_fields": ["title", "lead", "sections"],
      "recommended_fields": ["quote"],
      "recommended_blocks": ["heading", "section", "quote", "button"],
      "recipe": ["作品结论", "问题", "方法", "结果与可复用经验"],
      "example": "examples/pioneer-scenes/case-showcase.spec.json"
    },
    {
      "id": "review-notice",
      "name": "评审通知",
      "phase": "during",
      "type": "review",
      "default_preset": "blueprint-blue",
      "goal": "让参赛者和评审知道评审时间、标准、材料和结果节点。",
      "trigger": "评审开始前或评审规则更新",
      "keywords": ["评审", "评委", "评分", "审核"],
      "required_fields": ["title", "date_label", "facts", "sections"],
      "recommended_blocks": ["metrics", "section", "collapse"],
      "recipe": ["评审状态", "时间与范围", "评审维度", "结果发布时间"],
      "example": "examples/pioneer-scenes/review-notice.spec.json"
    },
    {
      "id": "finals-stage",
      "name": "决赛与路演",
      "phase": "during",
      "type": "finalists",
      "default_preset": "black-gold-stage",
      "goal": "把决赛名单、舞台流程、设备准备和展示节奏说清楚。",
      "trigger": "入围名单公布或决赛前一周",
      "keywords": ["决赛", "路演", "彩排", "入围"],
      "required_fields": ["title", "date_label", "facts", "timeline"],
      "recommended_blocks": ["facts", "timeline", "quote", "button"],
      "recipe": ["舞台信息", "入围项目摘要", "run of show", "展示准备"],
      "example": "examples/pioneer-scenes/finals-stage.spec.json"
    },
    {
      "id": "result-announcement",
      "name": "结果与颁奖",
      "phase": "post",
      "type": "launch",
      "default_preset": "black-gold-stage",
      "goal": "正式发布结果，感谢参与者，并把优秀作品引导到后续传播。",
      "trigger": "结果确认后首次公告",
      "keywords": ["结果", "获奖", "颁奖", "排名"],
      "required_fields": ["title", "facts", "sections", "buttons"],
      "recommended_blocks": ["heading", "facts", "section", "button"],
      "recipe": ["结果先行", "获奖或入选信息", "感谢与后续安排", "作品展示入口"],
      "example": "examples/pioneer-scenes/result-announcement.spec.json"
    },
    {
      "id": "event-recap",
      "name": "活动复盘",
      "phase": "post",
      "type": "story",
      "default_preset": "olive-editorial",
      "goal": "沉淀活动数据、参与者反馈和下一次可复用的运营经验。",
      "trigger": "活动结束后一周内",
      "keywords": ["复盘", "总结", "回顾", "沉淀"],
      "required_fields": ["title", "facts", "sections", "quote"],
      "recommended_blocks": ["metrics", "section", "quote", "collapse"],
      "recipe": ["活动结果", "做得好的地方", "需要改进的地方", "下一次行动"],
      "example": "examples/pioneer-scenes/event-recap.spec.json"
    }
  ]
}
